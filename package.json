{
  "name": "@ashetm/cont_roller",
  "version": "2.3.0-beta.0",
  "description": "jQuery-style controllers for Express: return your data, chain the status, guard before and after. Async, typed, zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:status": "node scripts/generate-status.mjs",
    "build": "tsup",
    "typecheck": "tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:types",
    "test:types": "tsc -p test/types/tsconfig.node16.json && tsc -p test/types/tsconfig.bundler.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsheTM/npm-cont_roller.git"
  },
  "bugs": {
    "url": "https://github.com/AsheTM/npm-cont_roller/issues"
  },
  "homepage": "https://github.com/AsheTM/npm-cont_roller#readme",
  "keywords": [
    "express",
    "controller",
    "middleware",
    "jquery",
    "chainable",
    "typescript",
    "handler"
  ],
  "author": "Haitham DAWOUD",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "arktype": "^2.2.9",
    "express": "^5.3.0",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@ashetm/types": "^1.3.1",
    "@standard-schema/spec": "^1.1.0"
  }
}
